              <ellipse cx="64" cy="100" rx="31" ry="17" fill="url(#dPosGrad)" filter="drop-shadow(0 0 7px rgba(52,211,153,0.4))"/>
              <text x="60" y="104" fill="#ffffff" font-size="11" font-weight="bold" font-family="monospace">+</text>

              <ellipse cx="100" cy="64" rx="17" ry="31" fill="url(#dNegGrad)" filter="drop-shadow(0 0 7px rgba(251,113,133,0.4))"/>
              <text x="96" y="68" fill="#ffffff" font-size="12" font-weight="bold" font-family="monospace">−</text>
              <ellipse cx="100" cy="136" rx="17" ry="31" fill="url(#dNegGrad)" filter="drop-shadow(0 0 7px rgba(251,113,133,0.4))"/>
              <text x="96" y="140" fill="#ffffff" font-size="12" font-weight="bold" font-family="monospace">−</text>
            </g>

            <circle cx="100" cy="100" r="3" fill="#fbbf24"/>
          `;
        } else {
          // ml === -1 => dyz: 4 lobes in the YZ plane (between y and z axes) in perspective
          svg.innerHTML = `
            ${commonDefs}
            <!-- Axis lines with clear YZ perspective plane -->
            <line x1="20" y1="100" x2="180" y2="100" stroke="#334155" stroke-dasharray="2 4"/>
            <line x1="100" y1="20" x2="100" y2="180" stroke="#475569" stroke-dasharray="3 3"/>
            <!-- Oblique axis representing Y -->
            <line x1="45" y1="155" x2="155" y2="45" stroke="#64748b" stroke-width="1.5"/>
            <text x="185" y="104" fill="#64748b" font-size="9" font-family="monospace">x</text>
            <text x="104" y="24" fill="#38bdf8" font-size="11" font-weight="bold" font-family="monospace">z</text>
            <text x="158" y="44" fill="#38bdf8" font-size="11" font-weight="bold" font-family="monospace">y</text>

            <!-- Lobes in the YZ plane (slanted ellipse perspective) -->
            <g transform="rotate(-30 100 100)">
              <ellipse cx="132" cy="100" rx="30" ry="16" fill="url(#dPosGrad)" filter="drop-shadow(0 0 7px rgba(52,211,153,0.4))"/>
              <text x="128" y="104" fill="#ffffff" font-size="11" font-weight="bold" font-family="monospace">+</text>
              <ellipse cx="68" cy="100" rx="30" ry="16" fill="url(#dPosGrad)" filter="drop-shadow(0 0 7px rgba(52,211,153,0.4))"/>
              <text x="64" y="104" fill="#ffffff" font-size="11" font-weight="bold" font-family="monospace">+</text>

              <ellipse cx="100" cy="68" rx="16" ry="30" fill="url(#dNegGrad)" filter="drop-shadow(0 0 7px rgba(251,113,133,0.4))"/>
              <text x="96" y="72" fill="#ffffff" font-size="12" font-weight="bold" font-family="monospace">−</text>
              <ellipse cx="100" cy="132" rx="16" ry="30" fill="url(#dNegGrad)" filter="drop-shadow(0 0 7px rgba(251,113,133,0.4))"/>
              <text x="96" y="136" fill="#ffffff" font-size="12" font-weight="bold" font-family="monospace">−</text>
            </g>

            <circle cx="100" cy="100" r="3" fill="#fbbf24"/>
          `;
        }
      } else {
        // f orbital: multi-lobed rosette
        svg.innerHTML = `
          <defs>
            <radialGradient id="fLobe" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#c084fc"/>
              <stop offset="100%" stop-color="#7e22ce" stop-opacity="0.25"/>
            </radialGradient>
          </defs>
          <circle cx="100" cy="100" r="18" fill="none" stroke="#64748b" stroke-dasharray="2 2"/>
          <g>
            <ellipse cx="100" cy="55" rx="14" ry="26" fill="url(#fLobe)"/>
            <ellipse cx="100" cy="145" rx="14" ry="26" fill="url(#fLobe)"/>
            <ellipse cx="55" cy="100" rx="26" ry="14" fill="url(#fLobe)"/>
            <ellipse cx="145" cy="100" rx="26" ry="14" fill="url(#fLobe)"/>
            <ellipse cx="68" cy="68" rx="22" ry="12" transform="rotate(45 68 68)" fill="url(#fLobe)"/>
            <ellipse cx="132" cy="132" rx="22" ry="12" transform="rotate(45 132 132)" fill="url(#fLobe)"/>
          </g>
          <circle cx="100" cy="100" r="3" fill="#fbbf24"/>
        `;
      }
    }

    window.onload = function() {
      startTimerLoop();
      state.currentQuestion = generatePracticeQuestion(state.practiceSubmode);
      renderPracticeQuestion();
      state.currentRulesChallenge = generateRulesChallenge();
      newRulesChallenge();
      updateLabControls();
      renderGuideTable();
    };
  </script>
