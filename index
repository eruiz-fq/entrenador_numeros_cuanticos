<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CuànticLAB - Entrenador de Números Cuánticos (2º Bachillerato)</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Inter Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
              900: '#312e81'
            }
          }
        }
      }
    }
  </script>
  <style>
    @media print {
      body * {
        visibility: hidden;
      }
      #printReportModal, #printReportModal * {
        visibility: visible;
      }
      #printReportModal {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 20px;
        background: white !important;
        box-shadow: none !important;
      }
      .no-print {
        display: none !important;
      }
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background-color: #cbd5e1;
      border-radius: 9999px;
    }
    .badge-sub {
      font-size: 0.72em;
      vertical-align: sub;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">

  <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <!-- Logo & Title -->
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-cyan-500 flex items-center justify-center text-white shadow-md shadow-indigo-100 font-mono font-bold text-lg">
            Ψ
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-bold text-lg text-slate-900 tracking-tight" id="appTitle">CuànticLAB</span>
              <span class="text-xs px-2 py-0.5 font-semibold bg-indigo-100 text-indigo-700 rounded-full border border-indigo-200">2º BAT</span>
            </div>
            <p class="text-xs text-slate-500 hidden sm:block" id="appSubtitle">Números cuánticos, orbitales atómicos y reglas cuánticas</p>
          </div>
        </div>

        <!-- Controls: Timer, Language Toggle, Reset -->
        <div class="flex items-center gap-2 sm:gap-4">
          <!-- Stopwatch -->
          <div class="flex items-center gap-1.5 bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200 font-mono text-xs sm:text-sm text-slate-700 shadow-inner">
            <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"/><path stroke-width="2" stroke-linecap="round" d="M12 6v6l4 2"/></svg>
            <span id="timerDisplay">00:00</span>
            <button id="toggleTimerBtn" onclick="toggleTimer()" title="Pausar / Reanudar" class="ml-1 text-slate-400 hover:text-slate-700">
              <svg id="timerIcon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
            </button>
          </div>

          <!-- Language Selector -->
          <div class="flex items-center bg-slate-100 p-0.5 rounded-lg border border-slate-200 text-xs font-semibold">
            <button id="langEsBtn" onclick="setLanguage('es')" class="px-2.5 py-1 rounded-md transition-all bg-white text-indigo-700 shadow-xs">ES</button>
            <button id="langCaBtn" onclick="setLanguage('ca')" class="px-2.5 py-1 rounded-md transition-all text-slate-600 hover:text-slate-900">CA</button>
          </div>

          <!-- Report Button -->
          <button onclick="openReportModal()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-50 text-indigo-700 border border-indigo-200 text-xs font-semibold hover:bg-indigo-100 transition-colors shadow-xs">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span class="hidden md:inline" id="btnReportTxt">Informe</span>
          </button>
        </div>
      </div>

      <div class="flex space-x-1 sm:space-x-4 border-t border-slate-100 overflow-x-auto py-1 custom-scrollbar text-sm">
        <button onclick="switchTab('practice')" id="tab-practice" class="tab-btn py-2 px-3 border-b-2 border-indigo-600 font-semibold text-indigo-600 whitespace-nowrap flex items-center gap-2">
          <span>🎯</span> <span data-i18n="navPractice">Entrenador Cuántico</span>
        </button>
        <button onclick="switchTab('rules')" id="tab-rules" class="tab-btn py-2 px-3 border-b-2 border-transparent font-medium text-slate-600 hover:text-indigo-600 whitespace-nowrap flex items-center gap-2">
          <span>⚖️</span> <span data-i18n="navRules">¿Válido o Prohibido?</span>
        </button>
        <button onclick="switchTab('lab')" id="tab-lab" class="tab-btn py-2 px-3 border-b-2 border-transparent font-medium text-slate-600 hover:text-indigo-600 whitespace-nowrap flex items-center gap-2">
          <span>🔬</span> <span data-i18n="navLab">Visualizador de Orbitales</span>
        </button>
        <button onclick="switchTab('guide')" id="tab-guide" class="tab-btn py-2 px-3 border-b-2 border-transparent font-medium text-slate-600 hover:text-indigo-600 whitespace-nowrap flex items-center gap-2">
          <span>📖</span> <span data-i18n="navGuide">Guía Teórica PAU</span>
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full">
    <!-- Scoreboard Metrics: Simplificado y compacto -->
    <div class="grid grid-cols-3 gap-3 sm:gap-4 mb-6 max-w-2xl mx-auto text-center">
      <div class="bg-white rounded-xl p-3 border border-slate-200 shadow-xs">
        <p class="text-xs text-slate-500 font-medium" data-i18n="metricTotal">Respondidas</p>
        <p class="text-xl font-bold text-slate-800" id="statTotal">0</p>
      </div>
      <div class="bg-white rounded-xl p-3 border border-slate-200 shadow-xs">
        <p class="text-xs text-slate-500 font-medium" data-i18n="metricScore">Aciertos</p>
        <p class="text-xl font-bold text-emerald-600" id="statCorrect">0</p>
      </div>
      <div class="bg-white rounded-xl p-3 border border-slate-200 shadow-xs">
        <p class="text-xs text-slate-500 font-medium" data-i18n="metricStreak">Racha actual</p>
        <p class="text-xl font-bold text-indigo-600" id="statStreak">0 🔥</p>
      </div>
    </div>

    <div id="section-practice" class="space-y-6">
      <!-- Mode Selection Header -->
      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-base sm:text-lg font-bold text-slate-900" data-i18n="practiceTitle">Entrenador de Números Cuánticos</h2>
          <p class="text-xs text-slate-500" data-i18n="practiceSubtitle">Escribe tu respuesta directamente en el campo de texto y pulsa Enter para comprobar.</p>
        </div>

        <div class="flex items-center gap-2">
          <div class="inline-flex rounded-lg border border-slate-200 p-1 bg-slate-50 text-xs font-medium">
            <button onclick="setPracticeSubmode('qn_to_orb')" id="btnSubmode1" class="px-2.5 py-1.5 rounded-md bg-white text-indigo-600 shadow-xs font-semibold transition">
              (n, l, m) ➔ Orbital
            </button>
            <button onclick="setPracticeSubmode('orb_to_qn')" id="btnSubmode2" class="px-2.5 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition">
              Orbital ➔ (n, l, m)
            </button>
            <button onclick="setPracticeSubmode('mixed')" id="btnSubmode3" class="px-2.5 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition">
              🔀 <span data-i18n="submodeMixed">Mixto</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Main Practice Card -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
        <div class="max-w-xl mx-auto text-center space-y-6">
          <div class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-100" id="questionCategoryTag">
            Categoría: Números Cuánticos ➔ Orbital
          </div>

          <!-- Prompt Box -->
          <div class="p-6 bg-gradient-to-b from-slate-50 to-indigo-50/30 rounded-2xl border border-slate-200/80">
            <p class="text-xs sm:text-sm font-medium text-slate-500 mb-1" id="questionPromptIntro">Dado el siguiente electrón:</p>
            <div class="text-2xl sm:text-3xl font-mono font-bold text-slate-900 tracking-wide my-3" id="questionMainDisplay">
              (n = 4, l = 2, m<span class="badge-sub">l</span> = -1, m<span class="badge-sub">s</span> = +½)
            </div>
            <p class="text-xs sm:text-sm text-slate-600 font-medium" id="questionActionPrompt">Escribe el orbital correspondiente:</p>
          </div>

          <!-- Direct Text Input Container -->
          <div id="practiceInputContainer" class="space-y-4">
            <!-- Populated with text inputs -->
          </div>

          <!-- Submit / Next Buttons -->
          <div class="flex items-center justify-center gap-3 pt-2">
            <button onclick="verifyPracticeAnswer()" id="btnCheckAnswer" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm shadow-md shadow-indigo-200 transition-all flex items-center gap-2">
              <span data-i18n="btnCheck">Comprobar Respuesta</span>
              <span class="text-[11px] opacity-75 font-mono bg-indigo-700/60 px-1.5 py-0.5 rounded">↵ Enter</span>
            </button>
            <button onclick="nextPracticeQuestion()" id="btnNextQuestion" class="hidden px-6 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-900 text-white font-semibold text-sm shadow-md transition-all flex items-center gap-2">
              <span data-i18n="btnNext">Siguiente Pregunta</span>
              <span class="text-[11px] opacity-75 font-mono bg-slate-700 px-1.5 py-0.5 rounded">↵ Enter</span>
            </button>
          </div>

          <!-- Pedagogical Feedback Box -->
          <div id="practiceFeedbackBox" class="hidden text-left p-4 rounded-xl border text-sm transition-all duration-300"></div>
        </div>
      </div>
    </div>

    <!-- Section Lab (Visualizador de apoyo simplificado) -->
    <div id="section-lab" class="hidden space-y-6">
      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
        <h2 class="text-lg font-bold text-slate-900" data-i18n="labTitle">Laboratorio Interactivo de Orbitales Atómicos</h2>
        <p class="text-sm text-slate-500" data-i18n="labSubtitle">Modifica los 4 números cuánticos y observa en directo cómo cambia la forma del orbital, su orientación espacial, la energía relativa y la capacidad de electrones.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Control Panel (Sliders & Selectors) -->
        <div class="lg:col-span-5 bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-5">
          <h3 class="text-sm font-bold uppercase tracking-wider text-indigo-700 flex items-center gap-2">
            <span>🎛️</span> <span data-i18n="labControls">Configuración de Números Cuánticos</span>
          </h3>

          <!-- n slider -->
          <div class="space-y-1.5">
            <div class="flex justify-between items-center text-sm font-semibold">
              <label for="sliderN" class="text-slate-700" data-i18n="labNLabel">Nivel Principal (n):</label>
              <span id="displayValN" class="font-mono text-indigo-600 font-bold bg-indigo-50 px-2 py-0.5 rounded border border-indigo-200">3</span>
            </div>
            <input type="range" id="sliderN" min="1" max="5" value="3" step="1" oninput="updateLabFromControls()" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-indigo-600">
            <p class="text-xs text-slate-400" data-i18n="labNDesc">Determina el volumen, tamaño del orbital y la energía principal (capa n=1 a 7).</p>
          </div>

          <!-- l selector -->
          <div class="space-y-1.5">
            <div class="flex justify-between items-center text-sm font-semibold">
              <label class="text-slate-700" data-i18n="labLLabel">Momento Angular / Azimutal (l):</label>
              <span id="displayValL" class="font-mono text-indigo-600 font-bold bg-indigo-50 px-2 py-0.5 rounded border border-indigo-200">l = 1 (p)</span>
            </div>
            <div id="btnGroupL" class="grid grid-cols-4 gap-2">
              <!-- Dynamically populated according to max allowed (n-1) -->
            </div>
            <p class="text-xs text-slate-400" data-i18n="labLDesc">Determina la forma geométrica del subnivel: s (l=0), p (l=1), d (l=2), f (l=3).</p>
          </div>

          <!-- ml selector -->
          <div class="space-y-1.5">
            <div class="flex justify-between items-center text-sm font-semibold">
              <label class="text-slate-700" data-i18n="labMlLabel">Magnético (m<span class="badge-sub">l</span>):</label>
              <span id="displayValMl" class="font-mono text-indigo-600 font-bold bg-indigo-50 px-2 py-0.5 rounded border border-indigo-200">0</span>
            </div>
            <div id="btnGroupMl" class="flex flex-wrap gap-2">
              <!-- Dynamically populated from -l to +l -->
            </div>
            <p class="text-xs text-slate-400" data-i18n="labMlDesc">Indica la orientación espacial del orbital en presencia de un campo magnético (-l ... 0 ... +l).</p>
          </div>

          <!-- ms selector -->
          <div class="space-y-1.5">
            <div class="flex justify-between items-center text-sm font-semibold">
              <label class="text-slate-700" data-i18n="labMsLabel">Espín del electrón (m<span class="badge-sub">s</span> o s):</label>
              <span id="displayValMs" class="font-mono text-indigo-600 font-bold bg-indigo-50 px-2 py-0.5 rounded border border-indigo-200">+½ ↑</span>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <button onclick="setLabSpin('+1/2')" id="btnSpinPlus" class="py-2 px-3 rounded-lg border border-indigo-500 bg-indigo-50 text-indigo-700 font-semibold text-xs flex items-center justify-center gap-1">
                <span>+½</span> <span>(↑ Sentido horario)</span>
              </button>
              <button onclick="setLabSpin('-1/2')" id="btnSpinMinus" class="py-2 px-3 rounded-lg border border-slate-200 bg-white text-slate-700 font-medium text-xs flex items-center justify-center gap-1 hover:border-indigo-300">
                <span>-½</span> <span>(↓ Sentido antihorario)</span>
              </button>
            </div>
            <p class="text-xs text-slate-400" data-i18n="labMsDesc">Momento angular intrínseco de giro del electrón sobre su propio eje.</p>
          </div>
        </div>

        <div class="lg:col-span-7 space-y-6">
          <!-- Orbital Shape Canvas / SVG Visualizer -->
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs flex flex-col items-center">
            <div class="w-full flex items-center justify-between mb-4">
              <div>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest" data-i18n="labOrbitalResult">Orbital Resultante</span>
                <h4 class="text-3xl font-extrabold text-indigo-700 font-mono" id="labOrbitalName">3p</h4>
              </div>
              <div class="text-right">
                <span class="text-xs text-slate-500 block" data-i18n="labSet">Cuaterna cuántica:</span>
                <span class="font-mono text-sm font-bold bg-slate-100 text-slate-800 px-2.5 py-1 rounded-md border border-slate-200" id="labSetDisplay">(3, 1, 0, +½)</span>
              </div>
            </div>

            <!-- SVG Visual Representation -->
            <div class="w-full h-56 sm:h-64 bg-slate-900 rounded-xl relative flex items-center justify-center overflow-hidden shadow-inner p-4" id="labGraphicContainer">
              <svg id="orbitalSvg" class="w-full h-full max-w-[280px] max-h-[240px]" viewBox="0 0 200 200">
                <!-- Dynamically generated SVG for orbital shapes -->
              </svg>
              <div class="absolute bottom-2 left-3 text-[11px] text-slate-400 font-mono" id="labSpatialLabel">
                Orientación: Eje Z (p<sub>z</sub>)
              </div>
              <div class="absolute top-2 right-3 text-[11px] text-indigo-300 font-mono bg-slate-800/80 px-2 py-0.5 rounded border border-slate-700">
                P(electrón) &gt; 90%
              </div>
            </div>

            <!-- Quantum Properties Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 w-full mt-4 text-center">
              <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200">
                <span class="text-[11px] text-slate-500 block" data-i18n="propDegeneracy">Degeneración</span>
                <span class="text-sm font-bold text-slate-800 font-mono" id="labPropDegeneracy">3 orbitales</span>
              </div>
              <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200">
                <span class="text-[11px] text-slate-500 block" data-i18n="propMaxElectronsSub">Capacidad subnivel</span>
                <span class="text-sm font-bold text-slate-800 font-mono" id="labPropMaxElectronsSub">6 e⁻ máx</span>
              </div>
              <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200">
                <span class="text-[11px] text-slate-500 block" data-i18n="propMaxElectronsLevel">Capacidad nivel (2n²)</span>
                <span class="text-sm font-bold text-slate-800 font-mono" id="labPropMaxElectronsLevel">18 e⁻ máx</span>
              </div>
              <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200">
                <span class="text-[11px] text-slate-500 block" data-i18n="propEnergyRule">Regla (n + l)</span>
                <span class="text-sm font-bold text-indigo-600 font-mono" id="labPropEnergyRule">3 + 1 = 4</span>
              </div>
            </div>

            <!-- Pedagogical takeaway notes -->
            <div class="mt-4 p-3 bg-amber-50 rounded-xl border border-amber-200 text-xs text-amber-900 w-full flex items-start gap-2.5">
              <span class="text-base">💡</span>
              <p id="labPedagogicalNote">
                Para el nivel <strong>n=3</strong>, los valores permitidos de <strong>l</strong> van de 0 hasta 2 (subniveles 3s, 3p, 3d). El valor l=1 corresponde a orbitales tipo p con forma bilobular y nodo en el núcleo.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="section-rules" class="hidden space-y-6">
      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-lg font-bold text-slate-900" data-i18n="rulesTitle">¿Combinación Permitida o Prohibida? (PAU)</h2>
          <p class="text-sm text-slate-500" data-i18n="rulesSubtitle">Justifica si los siguientes grupos de números cuánticos pueden describir un electrón en un átomo polielectrónico.</p>
        </div>
        <button onclick="newRulesChallenge()" class="px-4 py-2 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 rounded-lg text-xs font-bold border border-indigo-200 transition">
          🔄 <span data-i18n="rulesNewChallenge">Nuevo Desafío</span>
        </button>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs max-w-3xl mx-auto">
        <div class="text-center space-y-5">
          <span class="text-xs uppercase tracking-widest text-slate-400 font-bold" data-i18n="rulesQuestionLabel">Cuestión de Selectividad / Examen</span>
          
          <div class="p-6 bg-slate-50 rounded-2xl border border-slate-200 inline-block w-full">
            <p class="text-xs text-slate-500 mb-1" data-i18n="rulesQuestionPrompt">Evalúa la validez física de la siguiente combinación (n, l, m<span class="badge-sub">l</span>, m<span class="badge-sub">s</span>):</p>
            <div class="text-3xl sm:text-4xl font-mono font-bold text-indigo-700 py-3" id="rulesSetDisplay">
              (n = 3, l = 3, m<span class="badge-sub">l</span> = 0, m<span class="badge-sub">s</span> = +½)
            </div>
            <p class="text-sm text-slate-600" data-i18n="rulesChoosePrompt">¿Es un conjunto de números cuánticos físicamente posible para un electrón?</p>
          </div>

          <!-- Buttons for Allowed / Forbidden -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-md mx-auto pt-2">
            <button onclick="checkRulesDecision(true)" id="btnChoiceAllowed" class="p-4 rounded-xl border-2 border-slate-200 hover:border-emerald-500 hover:bg-emerald-50/50 font-bold text-slate-700 transition flex items-center justify-center gap-2 group">
              <span class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-lg group-hover:scale-110 transition">✓</span>
              <span data-i18n="choiceAllowed">SÍ, es PERMITIDO</span>
            </button>
            <button onclick="checkRulesDecision(false)" id="btnChoiceForbidden" class="p-4 rounded-xl border-2 border-slate-200 hover:border-rose-500 hover:bg-rose-50/50 font-bold text-slate-700 transition flex items-center justify-center gap-2 group">
              <span class="w-8 h-8 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center text-lg group-hover:scale-110 transition">✕</span>
              <span data-i18n="choiceForbidden">NO, es PROHIBIDO</span>
            </button>
          </div>

          <!-- Detailed Justification Panel (Shown after choosing) -->
          <div id="rulesJustificationPanel" class="hidden text-left p-5 rounded-xl border text-sm transition-all space-y-3">
            <!-- Injected by JS -->
          </div>

          <div class="pt-2">
