          </g>
          <circle cx="100" cy="100" r="3" fill="#fbbf24"/>
        `;
      } else if (l === 2) {
        // d orbital: 5 DISTINCT geometries according to ml value
        // Gradients for positive and negative wavefunction phases
        const commonDefs = `
          <defs>
            <radialGradient id="dPosGrad" cx="50%" cy="40%" r="60%">
