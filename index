    function checkRulesDecision(userSaidAllowed) {
      const ch = state.currentRulesChallenge;
      const isEs = state.lang === 'es';
      const isCorrect = (userSaidAllowed === ch.isValid);

      document.getElementById('btnChoiceAllowed').disabled = true;
      document.getElementById('btnChoiceForbidden').disabled = true;

      state.stats.total++;
      if (isCorrect) {
        state.stats.correct++;
        state.stats.streak++;
        if (state.stats.streak > state.stats.maxStreak) {
          state.stats.maxStreak = state.stats.streak;
        }
      } else {
        state.stats.streak = 0;
      }

      state.userAnswers.push({
        prompt: `¿(n=${ch.n}, l=${ch.l}, ml=${ch.ml}, ms=${ch.ms}) es permitido?`,
        userAnswer: userSaidAllowed ? (isEs ? 'Permitido' : 'Permès') : (isEs ? 'Prohibido' : 'Prohibit'),
        correctAnswer: ch.isValid ? (isEs ? 'Permitido' : 'Permès') : (isEs ? 'Prohibido' : 'Prohibit'),
        isCorrect
      });

      updateScoreboardUI();

      const panel = document.getElementById('rulesJustificationPanel');
      panel.classList.remove('hidden');
      const text = isEs ? ch.justification_es : ch.justification_ca;
      panel.className = `text-left p-4 rounded-xl border text-sm transition-all space-y-1.5 ${isCorrect ? 'bg-emerald-50 border-emerald-200 text-emerald-950' : 'bg-rose-50 border-rose-200 text-rose-950'}`;
      panel.innerHTML = `
        <div class="flex items-center gap-2">
          <span class="text-lg">${isCorrect ? '🎯' : '⚠️'}</span>
          <span class="font-bold text-sm">${isCorrect ? (isEs ? '¡Dictamen Correcto!' : 'Dictamen Correcte!') : (isEs ? 'Dictamen Incorrecto' : 'Dictamen Incorrecte')}</span>
        </div>
        <p class="text-xs leading-relaxed font-sans">${text}</p>
      `;

      document.getElementById('btnRulesNext').classList.remove('hidden');
    }

    function updateScoreboardUI() {
      const { total, correct, streak } = state.stats;
      document.getElementById('statTotal').textContent = total;
      document.getElementById('statCorrect').textContent = correct;
      document.getElementById('statStreak').textContent = `${streak} 🔥`;
    }

