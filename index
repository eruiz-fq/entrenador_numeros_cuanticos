      document.getElementById('btnSubmode1').className = mode === 'qn_to_orb' ? 'px-2.5 py-1.5 rounded-md bg-white text-indigo-600 shadow-xs font-semibold transition' : 'px-2.5 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition';
      document.getElementById('btnSubmode2').className = mode === 'orb_to_qn' ? 'px-2.5 py-1.5 rounded-md bg-white text-indigo-600 shadow-xs font-semibold transition' : 'px-2.5 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition';
