    function generateRulesChallenge() {
      const isValid = Math.random() > 0.5;

      if (isValid) {
        const n = Math.floor(Math.random() * 4) + 1;
        const l = Math.floor(Math.random() * n);
        const ml = Math.floor(Math.random() * (2 * l + 1)) - l;
        const ms = Math.random() > 0.5 ? '+½' : '-½';

        return {
          n, l, ml, ms,
          isValid: true,
          justification_es: `✓ PERMITIDA: n=${n} ≥ 1; l=${l} < n; ml=${ml} está entre -${l} y +${l}; y ms=${ms} es semientero.`,
          justification_ca: `✓ PERMESA: n=${n} ≥ 1; l=${l} < n; ml=${ml} està entre -${l} i +${l}; i ms=${ms} és semienter.`
        };
      } else {
        const errType = Math.floor(Math.random() * 3);
        let n = Math.floor(Math.random() * 3) + 1;
        let l = 0;
        let ml = 0;
        let ms = '+½';
        let errorMsg_es = '';
        let errorMsg_ca = '';

        if (errType === 0) {
          l = n; // l >= n prohibido
          errorMsg_es = `l no puede ser igual ni mayor que n (l=${l}, n=${n}). El máximo de l es n - 1 = ${n - 1}.`;
          errorMsg_ca = `l no pot ser igual ni major que n (l=${l}, n=${n}). El màxim de l és n - 1 = ${n - 1}.`;
        } else if (errType === 1) {
          l = 1;
          ml = Math.random() > 0.5 ? 2 : -2; // ml fuera de rango
          errorMsg_es = `ml=${ml} está fuera del rango permitido [-${l}, +${l}].`;
          errorMsg_ca = `ml=${ml} està fora del rang permès [-${l}, +${l}].`;
        } else {
          l = 0;
          ms = '0'; // spin invalido
          errorMsg_es = `ms solo puede ser +½ o -½ (nunca 0 ni enteros).`;
          errorMsg_ca = `ms només pot ser +½ o -½ (mai 0 ni enters).`;
        }

        return {
          n, l, ml, ms,
          isValid: false,
          justification_es: `✕ PROHIBIDA: ${errorMsg_es}`,
          justification_ca: `✕ PROHIBIDA: ${errorMsg_ca}`
        };
      }
    }

