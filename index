    function formatTime(totalSeconds) {
      const mins = Math.floor(totalSeconds / 60);
      const secs = totalSeconds % 60;
      return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    function startTimerLoop() {
      if (state.timer.intervalId) clearInterval(state.timer.intervalId);
      state.timer.intervalId = setInterval(() => {
        if (state.timer.running) {
          state.timer.seconds++;
          const timerDisplay = document.getElementById('timerDisplay');
          if (timerDisplay) {
            timerDisplay.textContent = formatTime(state.timer.seconds);
          }
        }
      }, 1000);
    }

    function toggleTimer() {
      state.timer.running = !state.timer.running;
      const icon = document.getElementById('timerIcon');
      if (icon) {
        if (state.timer.running) {
          icon.innerHTML = `<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>`;
        } else {
          icon.innerHTML = `<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/>`;
        }
      }
    }

    function showToast(message) {
      let toast = document.getElementById('appToast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'appToast';
        toast.className = 'fixed bottom-5 right-5 z-50 bg-slate-900 text-white px-4 py-2.5 rounded-xl shadow-lg text-xs font-semibold transition-opacity duration-300 opacity-0 pointer-events-none flex items-center gap-2';
        document.body.appendChild(toast);
      }
      toast.textContent = message;
      toast.classList.remove('opacity-0');
      toast.classList.add('opacity-100');
      setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0');
      }, 2500);
    }

    function openReportModal() {
      const modal = document.getElementById('reportModalBackdrop');
      if (!modal) return;

      const now = new Date();
      const dateEl = document.getElementById('reportDateDisplay');
      const timeEl = document.getElementById('reportTimeDisplay');
      if (dateEl) dateEl.textContent = now.toLocaleDateString() + ' ' + now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      if (timeEl) timeEl.textContent = formatTime(state.timer.seconds);

      const repTotal = document.getElementById('repTotal');
      const repCorrect = document.getElementById('repCorrect');
      const repWrong = document.getElementById('repWrong');
      const repMaxStreak = document.getElementById('repMaxStreak');

      if (repTotal) repTotal.textContent = state.stats.total;
      if (repCorrect) repCorrect.textContent = state.stats.correct;
      if (repWrong) repWrong.textContent = Math.max(0, state.stats.total - state.stats.correct);
      if (repMaxStreak) repMaxStreak.textContent = state.stats.maxStreak;

      const tbody = document.getElementById('reportTableBody');
      if (tbody) {
        tbody.innerHTML = '';
        if (state.userAnswers.length === 0) {
          tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-400 text-xs italic">${state.lang === 'es' ? 'No hay ejercicios registrados en esta sesión.' : 'No hi ha exercicis registrats en aquesta sessió.'}</td></tr>`;
        } else {
          state.userAnswers.forEach((ans, idx) => {
            const tr = document.createElement('tr');
            tr.className = ans.isCorrect ? 'bg-emerald-50/40' : 'bg-rose-50/40';
            tr.innerHTML = `
              <td class="p-2.5 font-mono text-slate-500">${idx + 1}</td>
              <td class="p-2.5 font-medium text-slate-800">${ans.prompt}</td>
              <td class="p-2.5 font-mono ${ans.isCorrect ? 'text-emerald-700 font-semibold' : 'text-rose-700 font-bold'}">${ans.userAnswer}</td>
              <td class="p-2.5 font-mono text-slate-700">${ans.correctAnswer}</td>
              <td class="p-2.5 text-center text-sm">${ans.isCorrect ? '✅' : '❌'}</td>
            `;
            tbody.appendChild(tr);
          });
        }
      }

      modal.classList.remove('hidden');
    }

    function closeReportModal() {
      const modal = document.getElementById('reportModalBackdrop');
      if (modal) modal.classList.add('hidden');
    }

    function triggerPrintPDF() {
      window.print();
    }

    function updateLabFromControls() {
      const slider = document.getElementById('sliderN');
      if (slider) {
        state.lab.n = parseInt(slider.value, 10);
      }
      updateLabControls();
    }

    function setLabL(lVal) {
      state.lab.l = lVal;
      // Adjust ml if outside range [-l, l]
      if (state.lab.ml > lVal) state.lab.ml = lVal;
      if (state.lab.ml < -lVal) state.lab.ml = -lVal;
      updateLabControls();
    }

    function setLabMl(mlVal) {
      state.lab.ml = mlVal;
      updateLabControls();
    }

    function setLabSpin(msVal) {
      state.lab.ms = msVal;
      updateLabControls();
    }

    function updateLabControls() {
      const { n, l, ml, ms } = state.lab;
      const isEs = state.lang === 'es';

      // Clamp l to max allowed: min(n - 1, 3)
      const maxL = Math.min(n - 1, 3);
      if (state.lab.l > maxL) {
        state.lab.l = maxL;
      }
      const currentL = state.lab.l;

      // Clamp ml to [-currentL, +currentL]
      if (state.lab.ml > currentL) state.lab.ml = currentL;
      if (state.lab.ml < -currentL) state.lab.ml = -currentL;
      const currentMl = state.lab.ml;

      // Update N display
      const dispN = document.getElementById('displayValN');
      if (dispN) dispN.textContent = n;

      // Update L display and buttons
      const dispL = document.getElementById('displayValL');
      const letter = SUBSHELLS[currentL].letter;
      if (dispL) dispL.textContent = `l = ${currentL} (${letter})`;

      const btnGroupL = document.getElementById('btnGroupL');
      if (btnGroupL) {
        btnGroupL.innerHTML = '';
        for (let i = 0; i <= maxL; i++) {
          const btn = document.createElement('button');
          const isSelected = i === currentL;
          btn.className = `py-1.5 px-2 rounded-lg text-xs font-mono font-bold border transition ${
            isSelected
              ? 'bg-indigo-600 text-white border-indigo-600 shadow-xs'
              : 'bg-white text-slate-700 border-slate-200 hover:border-indigo-300'
          }`;
          btn.textContent = `${i} (${SUBSHELLS[i].letter})`;
          btn.onclick = () => setLabL(i);
          btnGroupL.appendChild(btn);
        }
      }

      // Update ml display and buttons
      const dispMl = document.getElementById('displayValMl');
      if (dispMl) dispMl.textContent = currentMl > 0 ? `+${currentMl}` : `${currentMl}`;

      const btnGroupMl = document.getElementById('btnGroupMl');
      if (btnGroupMl) {
        btnGroupMl.innerHTML = '';
        for (let m = -currentL; m <= currentL; m++) {
          const btn = document.createElement('button');
          const isSelected = m === currentMl;
          const label = m > 0 ? `+${m}` : `${m}`;
          btn.className = `py-1 px-2.5 rounded-lg text-xs font-mono font-bold border transition ${
            isSelected
              ? 'bg-indigo-600 text-white border-indigo-600 shadow-xs'
              : 'bg-white text-slate-700 border-slate-200 hover:border-indigo-300'
          }`;
          btn.textContent = label;
          btn.onclick = () => setLabMl(m);
          btnGroupMl.appendChild(btn);
        }
      }

      // Update ms buttons
      const dispMs = document.getElementById('displayValMs');
      const isPlus = ms === '+1/2';
      if (dispMs) dispMs.textContent = isPlus ? '+½ ↑' : '-½ ↓';

      const btnPlus = document.getElementById('btnSpinPlus');
      const btnMinus = document.getElementById('btnSpinMinus');
      if (btnPlus && btnMinus) {
        btnPlus.className = `py-2 px-3 rounded-lg border font-semibold text-xs flex items-center justify-center gap-1 transition ${
          isPlus
            ? 'border-indigo-500 bg-indigo-50 text-indigo-700 shadow-xs'
            : 'border-slate-200 bg-white text-slate-600 hover:border-indigo-300'
        }`;
        btnMinus.className = `py-2 px-3 rounded-lg border font-semibold text-xs flex items-center justify-center gap-1 transition ${
          !isPlus
            ? 'border-indigo-500 bg-indigo-50 text-indigo-700 shadow-xs'
            : 'border-slate-200 bg-white text-slate-600 hover:border-indigo-300'
        }`;
      }

      // Output cards
      const orbName = `${n}${letter}`;
      const labOrbitalName = document.getElementById('labOrbitalName');
      if (labOrbitalName) labOrbitalName.textContent = orbName;

      const labSetDisplay = document.getElementById('labSetDisplay');
      if (labSetDisplay) {
        const msFormatted = isPlus ? '+½' : '-½';
        labSetDisplay.textContent = `(${n}, ${currentL}, ${currentMl > 0 ? '+' + currentMl : currentMl}, ${msFormatted})`;
      }

      const numOrbitals = 2 * currentL + 1;
      const maxSubElectrons = 2 * numOrbitals;
      const maxLevelElectrons = 2 * n * n;
      const energySum = n + currentL;

      const propDegen = document.getElementById('labPropDegeneracy');
      if (propDegen) propDegen.textContent = isEs ? `${numOrbitals} orbitales` : `${numOrbitals} orbitals`;

      const propMaxSub = document.getElementById('labPropMaxElectronsSub');
      if (propMaxSub) propMaxSub.textContent = `${maxSubElectrons} e⁻ máx`;

      const propMaxLvl = document.getElementById('labPropMaxElectronsLevel');
      if (propMaxLvl) propMaxLvl.textContent = `${maxLevelElectrons} e⁻ máx`;

      const propEnergy = document.getElementById('labPropEnergyRule');
      if (propEnergy) propEnergy.textContent = `${n} + ${currentL} = ${energySum}`;

      // Spatial orientation text
      const spatialLabel = document.getElementById('labSpatialLabel');
      if (spatialLabel) {
        if (currentL === 0) {
          spatialLabel.textContent = isEs ? 'Simetría: Esférica (sin orientación preferente)' : 'Simetria: Esfèrica (sense orientació preferent)';
        } else if (currentL === 1) {
          const axis = currentMl === -1 ? 'px' : currentMl === 0 ? 'pz' : 'py';
          spatialLabel.innerHTML = isEs
            ? `Orientación: Eje <strong>${axis.toUpperCase()}</strong> (${axis})`
            : `Orientació: Eix <strong>${axis.toUpperCase()}</strong> (${axis})`;
        } else if (currentL === 2) {
          const dLabels = {
            '-2': { name: 'dxy', desc_es: 'Plano XY (entre ejes X e Y)', desc_ca: 'Pla XY (entre eixos X i Y)' },
            '-1': { name: 'dyz', desc_es: 'Plano YZ (entre ejes Y y Z)', desc_ca: 'Pla YZ (entre eixos Y i Z)' },
            '0':  { name: 'dz²', desc_es: 'Eje Z con anillo toroidal ecuatorial en XY', desc_ca: 'Eix Z amb anell toroïdal equatorial en XY' },
            '1':  { name: 'dxz', desc_es: 'Plano XZ (entre ejes X y Z)', desc_ca: 'Pla XZ (entre eixos X i Z)' },
            '2':  { name: 'dx²-y²', desc_es: 'Sobre los ejes X e Y', desc_ca: 'Sobre els eixos X i Y' }
          };
          const info = dLabels[currentMl] || { name: 'd', desc_es: '', desc_ca: '' };
          spatialLabel.innerHTML = `<strong>${info.name}</strong> • ${isEs ? info.desc_es : info.desc_ca}`;
        } else {
          spatialLabel.textContent = isEs ? `Subnivel f: 7 orbitales degenerados` : `Subnivell f: 7 orbitals degenerats`;
        }
      }

      // Pedagogical note
      const pedNote = document.getElementById('labPedagogicalNote');
      if (pedNote) {
        const subName = isEs ? SUBSHELLS[currentL].name_es : SUBSHELLS[currentL].name_ca;
        pedNote.innerHTML = isEs
          ? `Para el nivel <strong>n = ${n}</strong>, los valores permitidos de <strong>l</strong> van de 0 hasta ${n - 1}. El subnivel <strong>${orbName}</strong> (${subName}) tiene <strong>${numOrbitals}</strong> orbitales orientados y admite hasta <strong>${maxSubElectrons} electrones</strong>.`
          : `Per al nivell <strong>n = ${n}</strong>, els valors permesos de <strong>l</strong> van de 0 fins a ${n - 1}. El subnivell <strong>${orbName}</strong> (${subName}) té <strong>${numOrbitals}</strong> orbitals orientats i admet fins a <strong>${maxSubElectrons} electrons</strong>.`;
      }

      renderOrbitalSvg(currentL, currentMl);
    }

    function renderOrbitalSvg(l, ml) {
      const svg = document.getElementById('orbitalSvg');
