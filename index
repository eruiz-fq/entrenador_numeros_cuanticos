      if (l === 0) {
        // s orbital: Sphere with radial gradient
        svg.innerHTML = `
          <defs>
            <radialGradient id="gradS" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#818cf8" stop-opacity="0.95"/>
