    function handlePracticeKey(event) {
      if (event.key === 'Enter') {
        const btnNext = document.getElementById('btnNextQuestion');
        if (!btnNext.classList.contains('hidden')) {
          nextPracticeQuestion();
        } else {
          verifyPracticeAnswer();
        }
      }
    }

    function verifyPracticeAnswer() {
      const q = state.currentQuestion;
      const isEs = state.lang === 'es';
      let isCorrect = false;
      let userAnswerText = '';
      let correctAnswerText = '';

      if (q.type === 'qn_to_orb') {
        const input = document.getElementById('practiceInputOrbital');
        const userVal = (input.value || '').trim().toLowerCase().replace(/\s+/g, '');
        if (!userVal) {
          showToast(isEs ? 'Escribe el nombre del orbital.' : 'Escriu el nom de l\'orbital.');
          return;
        }
        userAnswerText = userVal;
        correctAnswerText = q.correctAnswer.toLowerCase();
        isCorrect = (userVal === correctAnswerText);
      } else {
        const userN = document.getElementById('inputN').value.trim();
        const userL = document.getElementById('inputL').value.trim();

        if (userN === '' || userL === '') {
          showToast(isEs ? 'Completa los valores de n y l.' : 'Completa els valors de n i l.');
          return;
        }

        userAnswerText = `n=${userN}, l=${userL}`;
        correctAnswerText = `n=${q.correctN}, l=${q.correctL}`;
        isCorrect = (parseInt(userN, 10) === q.correctN && parseInt(userL, 10) === q.correctL);
      }

      state.stats.total++;
      if (isCorrect) {
        state.stats.correct++;
        state.stats.streak++;
        if (state.stats.streak > state.stats.maxStreak) {
          state.stats.maxStreak = state.stats.streak;
        }
      } else {
        state.stats.streak = 0;
      }

      state.userAnswers.push({
        prompt: q.type === 'qn_to_orb' ? `(n=${q.n}, l=${q.l}, ml=${q.ml}, ms=${q.ms})` : `Orbital ${q.orbitalName}`,
        userAnswer: userAnswerText,
        correctAnswer: correctAnswerText,
        isCorrect
      });

      updateScoreboardUI();

      const fbBox = document.getElementById('practiceFeedbackBox');
      const btnCheck = document.getElementById('btnCheckAnswer');
      const btnNext = document.getElementById('btnNextQuestion');

      btnCheck.classList.add('hidden');
      btnNext.classList.remove('hidden');
      fbBox.classList.remove('hidden');

      const exp = isEs ? q.explanation_es : q.explanation_ca;

      if (isCorrect) {
        fbBox.className = 'text-left p-4 rounded-xl border text-sm transition-all bg-emerald-50 border-emerald-200 text-emerald-900';
        fbBox.innerHTML = `
          <div class="flex items-start gap-2.5">
            <span class="text-xl">🎉</span>
            <div>
              <p class="font-bold text-emerald-800">${isEs ? '¡Correcto!' : 'Correcte!'}</p>
              <p class="mt-1 text-xs text-emerald-700 leading-relaxed">${exp}</p>
            </div>
          </div>
        `;
      } else {
        fbBox.className = 'text-left p-4 rounded-xl border text-sm transition-all bg-rose-50 border-rose-200 text-rose-900';
        fbBox.innerHTML = `
          <div class="flex items-start gap-2.5">
            <span class="text-xl">⚠️</span>
            <div>
              <p class="font-bold text-rose-800">${isEs ? 'Incorrecto' : 'Incorrecte'}</p>
              <p class="text-xs text-rose-700 mt-0.5">${isEs ? 'Respuesta correcta:' : 'Resposta correcta:'} <strong class="font-mono text-slate-800">${correctAnswerText}</strong></p>
              <p class="mt-1.5 text-xs text-slate-700 leading-relaxed">${exp}</p>
            </div>
          </div>
        `;
      }

      btnNext.focus();
    }

    function nextPracticeQuestion() {
      state.currentQuestion = generatePracticeQuestion(state.practiceSubmode);
      renderPracticeQuestion();
