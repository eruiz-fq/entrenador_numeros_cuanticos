        reportPrintTip: "Prem imprimir per descarregar el PDF de la sessió.",
        btnClose: "Tancar",
        btnPrint: "Imprimir / Desar en PDF"
      }
    };

    const SUBSHELLS = [
      { l: 0, letter: 's', name_es: 'sharp (esférico)', name_ca: 'sharp (esfèric)', orbitals: 1, maxE: 2 },
      { l: 1, letter: 'p', name_es: 'principal (bilobular)', name_ca: 'principal (bilobular)', orbitals: 3, maxE: 6 },
      { l: 2, letter: 'd', name_es: 'diffuse (tetralobular)', name_ca: 'diffuse (tetralobular)', orbitals: 5, maxE: 10 },
      { l: 3, letter: 'f', name_es: 'fundamental (complejo)', name_ca: 'fundamental (complex)', orbitals: 7, maxE: 14 }
    ];

    function generatePracticeQuestion(submode) {
      let modeToUse = submode;
      if (modeToUse === 'mixed') {
        modeToUse = Math.random() > 0.5 ? 'qn_to_orb' : 'orb_to_qn';
      }

      const prev = state.currentQuestion;
      let newQ = null;
      let attempts = 0;

      // Ensure that we generate a question distinct from the previous one
      do {
        if (modeToUse === 'qn_to_orb') {
          // n between 1 and 5 for a rich variety of realistic subshells
          const n = Math.floor(Math.random() * 5) + 1;
          const maxL = Math.min(n - 1, 3);
          const l = Math.floor(Math.random() * (maxL + 1));
          const ml = Math.floor(Math.random() * (2 * l + 1)) - l;
          const ms = Math.random() > 0.5 ? '+½' : '-½';
          const letter = SUBSHELLS[l].letter;
          const orbitalName = `${n}${letter}`;

          newQ = {
            type: 'qn_to_orb',
            n, l, ml, ms,
            orbitalName,
            correctAnswer: orbitalName,
            explanation_es: `Para n = ${n} y l = ${l}, el subnivel azimutal es '${letter}'. Por tanto, el orbital es '${orbitalName}'.`,
            explanation_ca: `Per a n = ${n} i l = ${l}, el subnivell azimutal és '${letter}'. Per tant, l'orbital és '${orbitalName}'.`
          };
        } else {
          // orb_to_qn: pick n from 1 to 5
          const n = Math.floor(Math.random() * 5) + 1;
          const maxL = Math.min(n - 1, 3);
          const l = Math.floor(Math.random() * (maxL + 1));
          const letter = SUBSHELLS[l].letter;
          const orbitalName = `${n}${letter}`;

          newQ = {
            type: 'orb_to_qn',
            n, l, letter,
            orbitalName,
            correctN: n,
            correctL: l,
            explanation_es: `Para el orbital ${orbitalName}: el nivel principal es n = ${n} y para el subnivel '${letter}', l = ${l} (orientaciones mₗ desde -${l} hasta +${l}).`,
            explanation_ca: `Per a l'orbital ${orbitalName}: el nivell principal és n = ${n} i per al subnivell '${letter}', l = ${l} (orientacions mₗ des de -${l} fins a +${l}).`
          };
        }
        attempts++;
      } while (
        prev &&
        attempts < 25 &&
        (
          (newQ.type === prev.type && newQ.type === 'qn_to_orb' && newQ.n === prev.n && newQ.l === prev.l && newQ.ml === prev.ml && newQ.ms === prev.ms) ||
          (newQ.type === prev.type && newQ.type === 'orb_to_qn' && newQ.orbitalName === prev.orbitalName)
        )
      );

      return newQ;
    }

