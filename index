        let rot = 0;
        let axisLabelX = 'x';
        let axisLabelY = 'z';

        if (ml === -1) {
          rot = 0; // px: horizontal along x
          axisLabelX = 'x';
          axisLabelY = 'y';
        } else if (ml === 0) {
          rot = 90; // pz: vertical along z
          axisLabelX = 'x';
          axisLabelY = 'z';
        } else {
          rot = 45; // py: tilted perspective along y
          axisLabelX = 'y';
          axisLabelY = 'z';
        }

        svg.innerHTML = `
          <defs>
            <radialGradient id="lobePos" cx="50%" cy="30%" r="60%">
              <stop offset="0%" stop-color="#38bdf8"/>
              <stop offset="100%" stop-color="#0284c7" stop-opacity="0.4"/>
